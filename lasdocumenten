/* ============================================================
   PDF + mail naar beproevingen@mookbv.nl
   ============================================================ */
const MAIL_TO = "beproevingen@mookbv.nl";

async function imgInfo(id){
  const res = await fetch(blobUrl(id));
  if(!res.ok) throw new Error("afbeelding niet gevonden");
  const blob = await res.blob();
  const data = await new Promise((ok,no) => {
    const fr = new FileReader(); fr.onload = () => ok(fr.result); fr.onerror = no; fr.readAsDataURL(blob);
  });
  const dim = await new Promise(ok => {
    const i = new Image(); i.onload = () => ok({w:i.naturalWidth, h:i.naturalHeight}); i.onerror = () => ok({w:4,h:3}); i.src = data;
  });
  return {data, w:dim.w, h:dim.h, png:/^data:image\/png/.test(data)};
}

function pdfName(r){
  const p = String(r.projectnr || "zonder-nr").replace(/[^\w-]+/g,"-");
  const d = (r.datum || new Date().toISOString().slice(0,10));
  const l = r.lasnummer ? "_las" + String(r.lasnummer).replace(/[^\w-]+/g,"-") : "";
  return `PE-lasborging_${p}_${d}${l}.pdf`;
}

async function makePdf(r){
  const libReady = await ensureJsPdf();
  if(!libReady) throw new Error("de PDF-bibliotheek kon niet geladen worden (netwerk geblokkeerd?)");
  const doc = new window.jspdf.jsPDF({unit:"mm", format:"a4"});
  const M = 15, PW = 210, PH = 297, CW = PW - 2*M, KW = 78, BOT = PH - 18;
  let y = M;

  const need = h => { if(y + h > BOT){ doc.addPage(); y = M; } };
  const setN = (sz, bold) => { doc.setFont("helvetica", bold ? "bold" : "normal"); doc.setFontSize(sz); };

  // kop
  setN(13, true);
  doc.text('Bijlage 4. "Liander PE Lasborgingsdocument"', M, y); y += 6;
  setN(8.5, false); doc.setTextColor(70);
  const meta = [`Projectnummer ${r.projectnr||"—"}`, nlDate(r.datum), `${r.adres||""} ${r.plaats||""}`.trim(), `Regio ${r.regio||"—"}`]
    .filter(Boolean).join("   |   ");
  doc.text(meta, M, y); y += 3.5;
  doc.setTextColor(0); doc.setDrawColor(30); doc.setLineWidth(0.4);
  doc.line(M, y, PW - M, y); y += 6;
  doc.setLineWidth(0.15); doc.setDrawColor(140);

  function row(k, v, sub){
    setN(8.5, true);
    const kl = doc.splitTextToSize(String(k), KW - 4);
    let sl = [];
    if(sub){ setN(7, false); sl = doc.splitTextToSize(String(sub), KW - 4); }
    setN(9, false);
    const vl = doc.splitTextToSize(String(v == null || v === "" ? "—" : v), CW - KW - 4);
    const h = Math.max(kl.length * 3.7 + sl.length * 2.9, vl.length * 3.9) + 3.4;
    need(h);
    doc.setFillColor(243, 243, 241);
    doc.rect(M, y, KW, h, "FD");
    doc.rect(M + KW, y, CW - KW, h, "S");
    setN(8.5, true); doc.text(kl, M + 2, y + 4);
    if(sub){ setN(7, false); doc.setTextColor(110); doc.text(sl, M + 2, y + 4 + kl.length * 3.7); doc.setTextColor(0); }
    setN(9, false); doc.text(vl, M + KW + 2, y + 4.2);
    y += h;
  }
  function head(txt){
    need(12); y += 4; setN(10, true);
    doc.text(txt, M, y + 3); y += 5.4;
    doc.setDrawColor(30); doc.setLineWidth(0.3); doc.line(M, y, PW - M, y);
    doc.setDrawColor(140); doc.setLineWidth(0.15); y += 2.4;
  }

  head("Algemene gegevens");
  TEXTFIELDS.forEach(f => row(`${f.n}. ${f.label}`, f.type === "date" ? nlDate(r[f.id]) : r[f.id]));

  head("Controlepunten");
  CHECKS.forEach(c => row(`${c.n}. ${c.q}`, r[c.id] === "ja" ? "JA" : r[c.id] === "nee" ? "NEE" : "—", c.hint || ""));

  // foto's
  const have = PHOTOS.filter(p => r.fotos && r.fotos[p.key]);
  if(have.length){
    head("Uitvoeringsfoto's");
    const bw = (CW - 2 * 4) / 3, bh = 42;
    need(bh + 12);
    const top = y;
    for(let i = 0; i < have.length; i++){
      const p = have[i], x = M + i * (bw + 4);
      try{
        const im = await imgInfo(r.fotos[p.key]);
        const s = Math.min(bw / im.w, bh / im.h);
        const w = im.w * s, h = im.h * s;
        doc.addImage(im.data, im.png ? "PNG" : "JPEG", x + (bw - w) / 2, top + (bh - h) / 2, w, h);
      }catch(e){}
      doc.rect(x, top, bw, bh, "S");
      setN(7, true); doc.text(p.label, x, top + bh + 3.5);
      setN(6.5, false); doc.setTextColor(110);
      doc.text(doc.splitTextToSize(p.desc, bw), x, top + bh + 6.6);
      doc.setTextColor(0);
    }
    y = top + bh + 14;
  }

  head("19. Verklaring");
  setN(9, false);
  const vl = doc.splitTextToSize(r.verklaring || "—", CW - 4);
  const vh = Math.max(20, vl.length * 4 + 5);
  need(vh); doc.rect(M, y, CW, vh, "S"); doc.text(vl, M + 2, y + 5); y += vh + 8;

  // paraaf
  need(34);
  if(r.paraaf){
    try{
      const im = await imgInfo(r.paraaf);
      const w = 48, h = Math.min(20, im.h * (w / im.w));
      doc.addImage(im.data, "PNG", M, y, w, h); y += h;
    }catch(e){ y += 18; }
  }else{ y += 18; }
  doc.setDrawColor(30); doc.line(M, y + 1, M + 60, y + 1); doc.setDrawColor(140);
  setN(8.5, false);
  doc.text(`Paraaf LTH — ${r.lth || ""}`, M, y + 5.5); y += 12;

  need(16); setN(7.5, false); doc.setTextColor(90);
  doc.text(doc.splitTextToSize(FOOTER_TXT, CW), M, y + 3);
  doc.setTextColor(0);

  const n = doc.getNumberOfPages();
  for(let i = 1; i <= n; i++){
    doc.setPage(i); setN(7, false); doc.setTextColor(130);
    doc.text(`${r.projectnr || ""}  ${nlDate(r.datum)}`, M, PH - 8);
    doc.text(`${i} / ${n}`, PW - M, PH - 8, {align:"right"});
    doc.setTextColor(0);
  }
  return doc;
}

function mailtoUrl(r){
  const sub = `PE Lasborgingsdocument — project ${r.projectnr||"?"}${r.lasnummer?` — lasnr. ${r.lasnummer}`:""} — ${nlDate(r.datum)}`;
  const body = [
    "Beste beproevingen,",
    "",
    "Bijgaand het PE lasborgingsdocument (Bijlage 4).",
    "",
    `Projectnummer : ${r.projectnr||"—"}`,
    `Datum         : ${nlDate(r.datum)}`,
    `Adres         : ${[r.adres, r.plaats].filter(Boolean).join(", ")||"—"}`,
    `Regio         : ${r.regio||"—"}`,
    `PE lasser     : ${r.lasser||"—"}`,
    `LTH           : ${r.lth||"—"}`,
    `Lasnummer     : ${r.lasnummer||"—"}`,
    `Buisleverancier: ${r.buislev||"—"}`,
    `Hulpstukleverancier: ${r.hulpstuk||"—"}`,
    "",
    anyNee(r) ? `Let op: één of meer controlepunten zijn met NEE beantwoord. Verklaring:\n${r.verklaring||""}` : "Alle controlepunten zijn akkoord.",
    "",
    "Met vriendelijke groet,"
  ].join("\n");
  const cc = r.lthmail ? `&cc=${encodeURIComponent(r.lthmail)}` : "";
  return `mailto:${MAIL_TO}?subject=${encodeURIComponent(sub)}${cc}&body=${encodeURIComponent(body)}`;
}

async function pdfAndMail(r, alsoMail){
  if(!r){ flash("Er is niets om te verwerken.", "err"); return; }
  flash("PDF wordt opgebouwd…", "warn", 30000);
  let doc;
  try{ doc = await makePdf(r); }
  catch(e){
    setStatus("PDF opbouwen is mislukt (" + (e && e.message ? e.message : "onbekende fout") + "). Gebruik de knop Print om als PDF op te slaan.", "err");
    return;
  }
  const name = pdfName(r);
  if(!downloads){
    setStatus("PDF opslaan is in deze weergave niet beschikbaar. Gebruik de knop Print om als PDF op te slaan.", "err");
    return;
  }
  try{
    await downloads.save({filename:name, data:doc.output("arraybuffer")});
  }catch(e){
    if(e && e.code === "declined"){ setStatus(""); return; }
    const code = e && e.code ? e.code : "onbekend";
    setStatus(`PDF opslaan is mislukt (${code}). Gebruik de knop Print om als PDF op te slaan.`, "err");
    return;
  }
  setStatus("");
  if(!alsoMail){ flash("PDF opgeslagen.", "ok"); return; }
  $("#mFile").textContent = name;
  $("#mOpen").setAttribute("href", mailtoUrl(r));
  $("#mailModal").hidden = false;
}

