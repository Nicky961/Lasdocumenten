function formsCol(uid){ return db.doc("lassen/" + uid).collection("forms"); }

function applyRecords(){
  records = [].concat(...Object.values(perUser)).sort((a,b) => (b.createdAt||0) - (a.createdAt||0));
  $("#cnt").textContent = records.length;
  if(view === "list") render();
