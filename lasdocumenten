function validate(){
  let firstBad = null;
  document.querySelectorAll(".field.invalid").forEach(el => el.classList.remove("invalid"));
  const bad = id => {
    const el = $("#fld-"+id);
    if(el){ el.classList.add("invalid"); if(!firstBad) firstBad = el; }
  };
  TEXTFIELDS.forEach(f => { if(f.req && !String(model[f.id]||"").trim()) bad(f.id); });
  CHECKS.forEach(c => { if(c.req && !model[c.id]) bad(c.id); });
  if(anyNee(model) && !String(model.verklaring||"").trim()) bad("verklaring");
  if(firstBad) firstBad.scrollIntoView({behavior:"smooth", block:"center"});
  return !firstBad;
}

async function save(){
  if(!validate()){ flash("Niet alle verplichte velden zijn ingevuld.", "err"); return; }
  if(!db){ flash("Opslaan is hier niet beschikbaar — gebruik Print om het formulier vast te leggen.", "err", 6000); return; }
  const btn = $("#btnSave"); if(btn){ btn.disabled = true; btn.textContent = "Opslaan…"; }
  try{
    if(!model.paraaf){ const sid = await uploadSignature(); if(sid) model.paraaf = sid; }
    const fotos = {};
    PHOTOS.forEach(p => { if(model.fotos[p.key]) fotos[p.key] = model.fotos[p.key]; });
    const body = {fotos, paraaf: model.paraaf || null, status:"afgerond", updatedAt: Date.now()};
    TEXTFIELDS.forEach(f => body[f.id] = String(model[f.id]||""));
    CHECKS.forEach(c => body[c.id] = model[c.id] || "");
    body.verklaring = String(model.verklaring||"");

    if(editingId){
      await db.doc(editingPath).update(body);
      const openId = editingId, openPath = editingPath;
      editingId = null; editingPath = null; model = blankModel(); sigDirty = false;
      detail = Object.assign({__id: openId, __path: openPath}, body, {createdAt: (records.find(r=>r.__path===openPath)||{}).createdAt});
      view = "detail"; render();
      flash("Wijzigingen opgeslagen.", "ok");
    }else{
      body.createdAt = Date.now();
      const ref = await formsCol(myUid).add(body);
      try{ await db.doc("lassen/" + myUid).set({updatedAt: Date.now()}); }catch(e){} // index zodat de eigenaar deze map vindt
      clearDraft();
      editingId = null; model = blankModel(); sigDirty = false;
      detail = Object.assign({__id: ref.id, __path: "lassen/"+myUid+"/forms/"+ref.id}, body);
      view = "detail"; render();
      flash("Formulier opgeslagen in het archief. Klik hieronder om de PDF te maken en te mailen.", "ok", 6000);
    }
  }catch(err){
    flash("Opslaan mislukt" + (err && err.code ? ` (${err.code})` : "") + ". Probeer opnieuw.", "err", 6000);
    if(btn){ btn.disabled = false; btn.textContent = "Formulier afronden"; }
  }
}

