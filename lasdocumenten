function watchForms(uid){
  if(!uid || formUnsubs[uid]) return;
  try{
    formUnsubs[uid] = formsCol(uid).orderBy("createdAt","desc").limit(200).onSnapshot(snap => {
      perUser[uid] = snap.docs.map(d => Object.assign({}, d.data() || {}, {__id:d.id, __path:"lassen/"+uid+"/forms/"+d.id}));
      applyRecords();
    }, () => { /* leesfout: stil */ });
  }catch(e){}
}

function subscribeRecords(){
  if(isAdmin && !STANDALONE){
    try{
      db.collection("lassen").onSnapshot(snap => { snap.docs.forEach(d => watchForms(d.id)); }, () => {});
    }catch(e){}
  }
  watchForms(myUid);
}

