document.addEventListener("input", e => {
  const t = e.target;
  const f = t.getAttribute && t.getAttribute("data-f");
  if(!f) return;
  if(t.hasAttribute("data-sel")){
    if(t.value === "__other"){
      model[f] = "";
      const oth = document.querySelector(`[data-f="${f}"][data-other]`);
      if(oth){ oth.style.display = "block"; oth.focus(); }
    }else{
      model[f] = t.value;
      const oth = document.querySelector(`[data-f="${f}"][data-other]`);
      if(oth){ oth.style.display = "none"; oth.value = ""; }
    }
  }else{
    model[f] = t.value;
  }
  const fld = t.closest(".field"); if(fld) fld.classList.remove("invalid");
  saveDraft();
});

document.addEventListener("click", e => {
  if(e.target.id === "status" || e.target.closest("#status")){ setStatus(""); }
});

document.addEventListener("click", async e => {
  const t = e.target.closest("[data-jn],[data-pick],[data-rmphoto],[data-open],button,a[id]");
  if(!t) return;

  // Ja/Nee
  const jn = t.getAttribute("data-jn");
  if(jn){
    model[jn] = model[jn] === t.getAttribute("data-val") ? "" : t.getAttribute("data-val");
    saveDraft(); renderForm(); return;
  }
  // foto kiezen / wissen
  const pick = t.getAttribute("data-pick");
  if(pick){ pendingPhotoKey = pick; $("#filepick").click(); return; }
  const rm = t.getAttribute("data-rmphoto");
  if(rm){ delete model.fotos[rm]; saveDraft(); renderForm(); return; }
  // record openen
  const open = t.getAttribute("data-open");
  if(open){ detail = records.find(r => r.__path === open) || null; view = "detail"; render(); return; }

  switch(t.id){
    case "tabForm": view = "form"; render(); break;
    case "tabList": view = "list"; render(); break;
    case "btnNew":  editingId = null; model = blankModel(); sigDirty = false; view = "form"; render(); break;
    case "btnSave": await save(); break;
    case "btnMailDirect": if(validate()) await pdfAndMail(model, true); else flash("Vul eerst de verplichte velden in.", "err"); break;
    case "btnPdfOnly": if(validate()) await pdfAndMail(model, false); else flash("Vul eerst de verplichte velden in.", "err"); break;
    case "btnMailRec": await pdfAndMail(detail, true); break;
    case "btnPdfRecOnly": await pdfAndMail(detail, false); break;
    case "mClose": $("#mailModal").hidden = true; break;
    case "mOpen": setTimeout(() => { $("#mailModal").hidden = true; }, 600); break;
    case "mCopy":
      try{ await navigator.clipboard.writeText(MAIL_TO); t.textContent = "Gekopieerd"; }
      catch(err){ t.textContent = MAIL_TO; }
      break;
    case "btnBack": view = "list"; render(); break;
    case "btnCsv": await exportCsv(); break;
    case "btnEdit": {
      editingId = detail.__id; editingPath = detail.__path;
      model = Object.assign(blankModel(), detail, {fotos: Object.assign({}, detail.fotos||{})});
      sigDirty = false; view = "form"; render();
      break;
    }
    case "btnDel": {
      if(!confirm("Dit formulier definitief verwijderen?")) return;
      try{ await db.doc(detail.__path).delete(); view = "list"; detail = null; render(); flash("Verwijderd.", "ok"); }
      catch(err){ flash("Verwijderen mislukt.", "err"); }
      break;
    }
    case "btnReset": {
      if(editingId){ editingId = null; editingPath = null; model = blankModel(); sigDirty = false; view = "list"; render(); return; }
      if(!confirm("Formulier leegmaken?")) return;
      model = blankModel(); sigDirty = false; clearDraft(); render();
      break;
    }
    case "sigClear": {
      if(model.paraaf){ model.paraaf = null; }
      sigDirty = false; saveDraft(); renderForm();
      break;
    }
  }
});

