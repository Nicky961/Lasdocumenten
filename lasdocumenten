<!DOCTYPE html>
<html lang="nl">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>PE Lasborgingsdocument</title>
<style>
:root{
  --bg:#f4f5f3;
  --surface:#ffffff;
  --surface-2:#f0f1ee;
  --border:#d9dbd5;
  --border-strong:#b9bcb4;
  --text:#1b1d19;
  --text-dim:#5f635b;
  --text-faint:#8b8f86;
  --accent:#1f6f4a;
  --accent-soft:#e3f0e8;
  --accent-text:#ffffff;
  --danger:#a4342a;
  --danger-soft:#fbe8e5;
  --warn:#8a6100;
  --warn-soft:#fdf1d8;
  --radius:12px;
  --radius-sm:8px;
  --shadow:0 1px 2px rgba(0,0,0,.05), 0 6px 20px rgba(0,0,0,.05);
  --mono:ui-monospace,"SF Mono",Menlo,Consolas,monospace;
  --sans:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,"Helvetica Neue",Arial,sans-serif;
}
@media (prefers-color-scheme: dark){
  :root:not([data-theme="light"]){
    --bg:#121411;
    --surface:#1b1e1a;
    --surface-2:#232722;
    --border:#333730;
    --border-strong:#4a4f46;
    --text:#e8eae5;
    --text-dim:#a6aba1;
    --text-faint:#7b8077;
    --accent:#4fae7d;
    --accent-soft:#1d2e25;
    --accent-text:#0d1410;
    --danger:#e3796c;
    --danger-soft:#33201d;
    --warn:#d9ab4c;
    --warn-soft:#2e2717;
    --shadow:0 1px 2px rgba(0,0,0,.4), 0 6px 20px rgba(0,0,0,.3);
  }
}
:root[data-theme="dark"]{
  --bg:#121411;
  --surface:#1b1e1a;
  --surface-2:#232722;
  --border:#333730;
  --border-strong:#4a4f46;
  --text:#e8eae5;
  --text-dim:#a6aba1;
  --text-faint:#7b8077;
  --accent:#4fae7d;
  --accent-soft:#1d2e25;
  --accent-text:#0d1410;
  --danger:#e3796c;
  --danger-soft:#33201d;
  --warn:#d9ab4c;
  --warn-soft:#2e2717;
  --shadow:0 1px 2px rgba(0,0,0,.4), 0 6px 20px rgba(0,0,0,.3);
}

*{box-sizing:border-box}
html,body{margin:0;padding:0}
body{
  background:var(--bg);
  color:var(--text);
  font-family:var(--sans);
  font-size:16px;
  line-height:1.5;
  -webkit-text-size-adjust:100%;
}
.wrap{max-width:760px;margin:0 auto;padding:0 16px 120px}

/* ---------- header ---------- */
header.top{
  position:sticky;top:0;z-index:30;
  background:var(--bg);
  border-bottom:1px solid var(--border);
}
.top-inner{max-width:760px;margin:0 auto;padding:14px 16px 0}
.brand{display:flex;align-items:baseline;gap:10px;flex-wrap:wrap}
.brand h1{font-size:17px;margin:0;font-weight:650;letter-spacing:-.01em}
.brand .sub{font-size:12px;color:var(--text-faint);font-family:var(--mono)}
.tabs{display:flex;gap:2px;margin-top:12px}
.tab{
  appearance:none;background:none;border:0;border-bottom:2px solid transparent;
  padding:9px 12px;font:inherit;font-size:14px;font-weight:550;color:var(--text-dim);
  cursor:pointer;
}
.tab[aria-selected="true"]{color:var(--text);border-bottom-color:var(--accent)}
.tab .count{
  font-size:11px;font-family:var(--mono);background:var(--surface-2);
  border-radius:99px;padding:1px 6px;margin-left:5px;color:var(--text-dim);
}

/* ---------- status strip ---------- */
.status{
  font-size:12.5px;padding:7px 12px;border-radius:var(--radius-sm);
  margin:12px 0 0;display:none;cursor:pointer;
}
.status.show{display:block}
.status.warn{background:var(--warn-soft);color:var(--warn)}
.status.err{background:var(--danger-soft);color:var(--danger)}
.status.ok{background:var(--accent-soft);color:var(--accent)}

/* ---------- sections ---------- */
section.card{
  background:var(--surface);
  border:1px solid var(--border);
  border-radius:var(--radius);
  margin-top:16px;
  overflow:hidden;
  box-shadow:var(--shadow);
}
.card-head{
  padding:13px 16px;border-bottom:1px solid var(--border);
  display:flex;align-items:center;gap:10px;background:var(--surface-2);
}
.card-head .n{
  font-family:var(--mono);font-size:11px;color:var(--text-faint);
  border:1px solid var(--border-strong);border-radius:4px;padding:1px 5px;
}
.card-head h2{margin:0;font-size:14px;font-weight:650;letter-spacing:.01em}
.card-body{padding:6px 16px 16px}

/* ---------- fields ---------- */
.field{padding:12px 0;border-bottom:1px solid var(--border)}
.field:last-child{border-bottom:0}
.field > label.q, .field > .q{
  display:block;font-size:14.5px;font-weight:600;margin-bottom:3px;
}
.q .req{color:var(--danger);margin-left:2px}
.hint{font-size:12.5px;color:var(--text-dim);margin:0 0 9px;line-height:1.45}
.hint code{font-family:var(--mono);font-size:11.5px}

input[type="text"],input[type="date"],input[type="email"],textarea,select{
  width:100%;font:inherit;font-size:16px;
  background:var(--bg);
  color:var(--text);
  border:1px solid var(--border-strong);
  border-radius:var(--radius-sm);
  padding:10px 11px;
}
select{appearance:none;background-image:linear-gradient(45deg,transparent 50%,var(--text-dim) 50%),linear-gradient(135deg,var(--text-dim) 50%,transparent 50%);background-position:calc(100% - 17px) 50%,calc(100% - 12px) 50%;background-size:5px 5px,5px 5px;background-repeat:no-repeat;padding-right:34px}
textarea{min-height:96px;resize:vertical;line-height:1.5}
input:focus,textarea:focus,select:focus{outline:2px solid var(--accent);outline-offset:1px;border-color:var(--accent)}
.invalid input,.invalid textarea,.invalid select{border-color:var(--danger);background:var(--danger-soft)}
.err-msg{display:none;font-size:12.5px;color:var(--danger);margin-top:6px}
.invalid .err-msg{display:block}

.grid2{display:grid;grid-template-columns:1fr 1fr;gap:12px}
@media(max-width:560px){.grid2{grid-template-columns:1fr}}

/* ---------- ja / nee ---------- */
.jn{display:flex;gap:8px;margin-top:2px}
.jn button{
  flex:1;font:inherit;font-size:15px;font-weight:600;
  padding:12px 8px;border-radius:var(--radius-sm);
  border:1.5px solid var(--border-strong);
  background:var(--bg);color:var(--text-dim);cursor:pointer;
  display:flex;align-items:center;justify-content:center;gap:7px;
  min-height:48px;
}
.jn button .dot{width:9px;height:9px;border-radius:50%;background:var(--border-strong)}
.jn button[data-on="1"][data-val="ja"]{background:var(--accent-soft);border-color:var(--accent);color:var(--accent)}
.jn button[data-on="1"][data-val="ja"] .dot{background:var(--accent)}
.jn button[data-on="1"][data-val="nee"]{background:var(--danger-soft);border-color:var(--danger);color:var(--danger)}
.jn button[data-on="1"][data-val="nee"] .dot{background:var(--danger)}

/* ---------- foto's ---------- */
.photos{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-top:4px}
@media(max-width:560px){.photos{grid-template-columns:1fr}}
.photo{
  border:1.5px dashed var(--border-strong);border-radius:var(--radius-sm);
  background:var(--bg);padding:10px;text-align:left;position:relative;
  min-height:128px;display:flex;flex-direction:column;
}
.photo.filled{border-style:solid;border-color:var(--accent);background:var(--accent-soft)}
.photo .plabel{font-size:11.5px;font-weight:700;font-family:var(--mono);color:var(--text-faint);margin-bottom:4px}
.photo.filled .plabel{color:var(--accent)}
.photo .pdesc{font-size:11.5px;color:var(--text-dim);line-height:1.4;flex:1}
.photo img{width:100%;height:96px;object-fit:cover;border-radius:5px;margin-bottom:7px;background:var(--surface-2)}
.photo .pbtns{display:flex;gap:6px;margin-top:8px}
.photo .pbtns button{
  flex:1;font:inherit;font-size:12.5px;font-weight:600;padding:8px 6px;
  border-radius:6px;border:1px solid var(--border-strong);
  background:var(--surface);color:var(--text);cursor:pointer;min-height:36px;
}
.photo .pbtns button.rm{color:var(--danger);border-color:var(--danger)}
.photo .busy{font-size:11.5px;color:var(--text-dim);font-family:var(--mono)}
input[type="file"]{display:none}

/* ---------- handtekening ---------- */
.sigwrap{border:1px solid var(--border-strong);border-radius:var(--radius-sm);background:var(--bg);overflow:hidden}
canvas#sig{display:block;width:100%;height:150px;touch-action:none;cursor:crosshair}
.sigwrap img{display:block;width:100%;max-height:150px;object-fit:contain;background:var(--bg)}
.sigbar{display:flex;justify-content:space-between;align-items:center;padding:7px 10px;border-top:1px solid var(--border);font-size:12px;color:var(--text-faint)}
.sigbar button{font:inherit;font-size:12.5px;background:none;border:0;color:var(--accent);font-weight:600;cursor:pointer;padding:4px 2px}

/* ---------- action bar ---------- */
.actionbar{
  position:fixed;left:0;right:0;bottom:0;z-index:40;
  background:var(--surface);border-top:1px solid var(--border);
  padding:11px 16px calc(11px + env(safe-area-inset-bottom));
}
.actionbar-inner{max-width:760px;margin:0 auto;display:flex;gap:9px;align-items:center}
.btn{
  font:inherit;font-size:15px;font-weight:650;border-radius:var(--radius-sm);
  padding:13px 18px;cursor:pointer;border:1px solid var(--border-strong);
  background:var(--surface);color:var(--text);min-height:48px;white-space:nowrap;
}
.btn.primary{background:var(--accent);border-color:var(--accent);color:var(--accent-text);flex:1}
.btn.ghost{background:transparent}
.btn[disabled]{opacity:.45;cursor:not-allowed}
.savehint{font-size:12px;color:var(--text-faint);font-family:var(--mono);margin-left:auto}

/* ---------- archief ---------- */
.rec{
  background:var(--surface);border:1px solid var(--border);border-radius:var(--radius);
  padding:13px 15px;margin-top:10px;cursor:pointer;
}
.rec:hover{border-color:var(--border-strong)}
.rec-top{display:flex;justify-content:space-between;gap:10px;align-items:baseline}
.rec-top strong{font-size:15px}
.rec-meta{font-size:12.5px;color:var(--text-dim);margin-top:3px}
.pill{font-size:11px;font-weight:700;font-family:var(--mono);padding:2px 7px;border-radius:99px;white-space:nowrap}
.pill.ok{background:var(--accent-soft);color:var(--accent)}
.pill.att{background:var(--warn-soft);color:var(--warn)}
.pill.draft{background:var(--surface-2);color:var(--text-faint)}
.empty{text-align:center;padding:52px 20px;color:var(--text-faint);font-size:14px}
.toolbar{display:flex;gap:8px;margin-top:14px;flex-wrap:wrap}
.toolbar .btn{font-size:13.5px;padding:9px 13px;min-height:40px}

/* ---------- mail modal ---------- */
.modal-back{position:fixed;inset:0;z-index:60;background:rgba(0,0,0,.45);display:flex;align-items:flex-end;justify-content:center;padding:16px}
.modal-back[hidden]{display:none}
@media(min-width:560px){.modal-back{align-items:center}}
.modal{background:var(--surface);border:1px solid var(--border);border-radius:var(--radius);box-shadow:var(--shadow);padding:18px;max-width:440px;width:100%}
.modal h3{margin:0 0 4px;font-size:16px}
.modal .mfile{font-family:var(--mono);font-size:12px;color:var(--accent);margin:0 0 10px;word-break:break-all}
.modal .mtxt{font-size:13.5px;color:var(--text-dim);line-height:1.5;margin:0 0 14px}
.modal .mrow{display:flex;justify-content:space-between;align-items:center;gap:10px;font-size:12.5px;color:var(--text-dim);margin-top:11px;flex-wrap:wrap}
.modal .mrow code{font-family:var(--mono);font-size:12px}
.modal .lnk{background:none;border:0;font:inherit;font-size:12.5px;font-weight:600;color:var(--accent);cursor:pointer;padding:2px}

/* ---------- print ---------- */
#printArea{display:none}
@media print{
  body{background:#fff;color:#000;font-size:11pt}
  header.top,.actionbar,#app,.status{display:none !important}
  #printArea{display:block;padding:0}
  .p-h1{font-size:15pt;margin:0 0 2mm}
  .p-sub{font-size:9pt;color:#444;margin:0 0 5mm;border-bottom:1px solid #000;padding-bottom:3mm}
  .p-sec{font-size:10.5pt;font-weight:700;margin:5mm 0 2mm;text-decoration:underline}
  table.p-t{width:100%;border-collapse:collapse;font-size:9.5pt}
  table.p-t td{border:1px solid #999;padding:1.7mm 2.2mm;vertical-align:top}
  table.p-t td.k{width:42%;background:#f2f2f2;font-weight:600}
  .p-photos{display:flex;gap:3mm;margin-top:3mm;page-break-inside:avoid}
  .p-photos figure{flex:1;margin:0}
  .p-photos img{width:100%;border:1px solid #999}
  .p-photos figcaption{font-size:7.5pt;margin-top:1mm}
  .p-sig{margin-top:6mm;page-break-inside:avoid}
  .p-sig img{height:20mm;border-bottom:1px solid #000}
  .p-foot{margin-top:6mm;font-size:8pt;font-style:italic;color:#333;border-top:1px solid #999;padding-top:2mm}
}
</style>
</head>
<body>

<header class="top">
  <div class="top-inner">
    <div class="brand">
      <h1>PE Lasborgingsdocument</h1>
      <span class="sub">Bijlage 4 &middot; Liander</span>
    </div>
    <div class="tabs" role="tablist">
      <button class="tab" role="tab" id="tabForm" aria-selected="true">Nieuw formulier</button>
      <button class="tab" role="tab" id="tabList" aria-selected="false">Archief <span class="count" id="cnt">0</span></button>
    </div>
  </div>
</header>

<div class="wrap">
  <div class="status" id="status"></div>
  <div id="app"></div>
</div>

<div class="actionbar" id="actionbar">
  <div class="actionbar-inner" id="actionbarInner"></div>
</div>

<input type="file" id="filepick" accept="image/*" capture="environment">

<div id="mailModal" class="modal-back" hidden>
  <div class="modal">
    <h3>PDF klaar</h3>
    <p class="mfile" id="mFile"></p>
    <p class="mtxt">De PDF is opgeslagen op dit apparaat. Open hieronder de mail — onderwerp en tekst staan al klaar. <strong>Voeg de zojuist opgeslagen PDF nog toe als bijlage</strong> (een webpagina mag zelf geen bestand aan een mail hangen).</p>
    <a class="btn primary" id="mOpen" href="#" style="display:block;text-align:center;text-decoration:none">Mail openen</a>
    <div class="mrow"><span>Aan: <code>beproevingen@mookbv.nl</code></span><button class="lnk" id="mCopy">Kopieer adres</button></div>
    <button class="btn ghost" id="mClose" style="width:100%;margin-top:8px">Sluiten</button>
  </div>
</div>

<script>
"use strict";

/* ============================================================
   Formulierdefinitie — 1:1 met Bijlage 4
   ============================================================ */
const LASSERS = ["Martin de Haan","Ronnie Terweij"];
const BUISLEV = ["Wavin","George Fisher (GF)"];
const REGIOS  = ["Noord-Holland","Zuid-Holland"];

const PHOTOS = [
  {key:"A", label:"Foto A", desc:"De werkplek inclusief de mogelijke voorzorgsmaatregelen."},
  {key:"B", label:"Foto B", desc:"Tijdens het lasproces: de laszone inclusief inklem- en positioneringsgereedschap."},
  {key:"C", label:"Foto C", desc:"De PE las inclusief de geschreven lasgegevens."}
];

const CHECKS = [
  {id:"q12", n:12, sec:"Voorbereiding", q:"Is werkplek, materiaal en materieel correct voorbereid?",
   hint:"werkruimte / lasgereedschap / buis klasse / lashulpstuk", req:true},
  {id:"q13", n:13, sec:"Voorbereiding", q:"Zijn negatieve omgevingsfactoren uitgesloten?",
   hint:"wind / temperatuur / vocht uitgesloten / zon / tocht door buis uitgesloten", req:true},
  {id:"q14", n:14, sec:"Voorbewerking", q:"NTA8828 Elektrolas",
   hint:"buisuiteinden haaks / rondingsklemmen / geschild / insteekdiepte afgetekend / inklem- en positioneringsklemmen / reinigen / lasindicatoren vrij van vervuiling", req:true},
  {id:"q15", n:15, sec:"Lasproces", q:"De PE las is uitgevoerd volgens het van toepassing zijnde lasproces?",
   hint:"NTA8828", req:true},
  {id:"q17", n:17, sec:"Uitvoeringsfoto's", q:"Zijn de foto's gemaakt?", hint:"", req:true},
  {id:"q18", n:18, sec:"Lasinspectie", q:"PE las geïnspecteerd, door het uitvoeren van een visuele inspectie?", hint:"", req:true}
];

const TEXTFIELDS = [
  {id:"datum",      n:1,  label:"Datum",              type:"date",   req:true},
  {id:"projectnr",  n:2,  label:"Projectnummer",      type:"text",   req:true, ph:"bijv. 30012345"},
  {id:"lasser",     n:3,  label:"Naam PE lasser",     type:"select", req:true, opts:LASSERS, other:true},
  {id:"buislev",    n:4,  label:"Buisleverancier",    type:"select", req:true, opts:BUISLEV},
  {id:"regio",      n:5,  label:"Regio",              type:"select", req:true, opts:REGIOS},
  {id:"adres",      n:6,  label:"Adres",              type:"text",   req:true, ph:"straat + huisnummer"},
  {id:"plaats",     n:7,  label:"Plaats",             type:"text",   req:true},
  {id:"lth",        n:8,  label:"Naam LTH",           type:"text",   req:true},
  {id:"lthmail",    n:9,  label:"Mailadres LTH",      type:"email",  req:false},
  {id:"hulpstuk",   n:10, label:"Hulpstuk Leverancier",type:"text",  req:true},
  {id:"lasnummer",  n:11, label:"Lasnummer",          type:"text",   req:false}
];

const FOOTER_TXT = "De betreffende PE lasser is verantwoordelijk voor het correct vullen van dit borgingsdocument. " +
  "De LTH dient dit borgingsdocument te paraferen als hij de las visueel geïnspecteerd heeft en akkoord is met " +
  "het eindresultaat, indien van toepassing onderbouwd met een verklaring.";

/* ============================================================
   State
   ============================================================ */
const DRAFT_KEY = "pe-las-draft-v1";
let view = "form";             // "form" | "list" | "detail"
let model = blankModel();
let editingId = null;          // db doc id wanneer we een bestaande bewerken
let detail = null;             // record dat in detailweergave staat
let records = [];
let db = null, assets = null, downloads = null;
let myUid = null, isAdmin = false, editingPath = null;
const formUnsubs = {}, perUser = {};
let capsReady = false;
let pendingPhotoKey = null;
let sigDirty = false;

function blankModel(){
  const m = {fotos:{}, paraaf:null, status:"concept"};
  TEXTFIELDS.forEach(f => m[f.id] = "");
  CHECKS.forEach(c => m[c.id] = "");
  m.verklaring = "";
  m.datum = new Date().toISOString().slice(0,10);
  return m;
}

/* ============================================================
   Helpers
   ============================================================ */
const $ = s => document.querySelector(s);
const esc = s => String(s == null ? "" : s).replace(/[&<>"']/g, c => ({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]));
const blobUrl = id => (id && String(id).slice(0,5) === "data:") ? id : "/_blob/" + id;

function setStatus(msg, kind){
  const el = $("#status");
  if(!msg){ el.className = "status"; el.textContent = ""; return; }
  el.className = "status show " + (kind || "warn");
  el.textContent = msg;
}
function flash(msg, kind, ms){
  setStatus(msg, kind || "ok");
  clearTimeout(flash._t);
  flash._t = setTimeout(() => setStatus(""), ms || 3200);
}
function nlDate(iso){
  if(!iso) return "—";
  const p = String(iso).split("-");
  return p.length === 3 ? `${p[2]}-${p[1]}-${p[0]}` : iso;
}
function anyNee(m){ return CHECKS.some(c => m[c.id] === "nee"); }
function recStatus(m){
  if(m.status !== "afgerond") return {cls:"draft", txt:"CONCEPT"};
  return anyNee(m) ? {cls:"att", txt:"VERKLARING"} : {cls:"ok", txt:"AKKOORD"};
}

/* localStorage draft — per-viewer gemak, mag falen */
function saveDraft(){
  if(editingId) return;
  try{ localStorage.setItem(DRAFT_KEY, JSON.stringify(model)); }catch(e){}
}
function loadDraft(){
  try{
    const raw = localStorage.getItem(DRAFT_KEY);
    if(raw){ const d = JSON.parse(raw); if(d && typeof d === "object") model = Object.assign(blankModel(), d); }
  }catch(e){}
}
function clearDraft(){ try{ localStorage.removeItem(DRAFT_KEY); }catch(e){} }

/* ============================================================
   Capabilities
   ============================================================ */
/* ============================================================
   Standalone-modus — werkt zonder claude.ai
   Als de app buiten Claude wordt gehost (window.claude bestaat niet),
   vallen db/assets/downloads terug op de browser zelf: localStorage
   voor het archief, data-URL's voor foto's/paraaf, en een gewone
   downloadlink voor PDF/CSV. Alles blijft dan lokaal in de browser
   van degene die het formulier invult — er is geen gedeeld archief
   tussen verschillende mensen/apparaten zonder eigen server.
   ============================================================ */
const STANDALONE = typeof claude === "undefined";

const LS_KEY = "pe_lasborging_records_v1";
function lsLoad(){ try{ return JSON.parse(localStorage.getItem(LS_KEY) || "[]"); }catch(e){ return []; } }
const lsListeners = [];
function lsSnap(){ return { docs: lsLoad().map(r => ({ id:r.id, exists:true, data:() => r })) }; }
function lsSave(arr){
  try{ localStorage.setItem(LS_KEY, JSON.stringify(arr)); }catch(e){}
  setTimeout(() => lsListeners.forEach(fn => { try{ fn(lsSnap()); }catch(e){} }), 0);
}

const localDb = {
  collection(){
    const self = {
      orderBy(){ return self; },
      limit(){ return self; },
      onSnapshot(next){
        lsListeners.push(next);
        next(lsSnap());
        return () => { const i = lsListeners.indexOf(next); if(i >= 0) lsListeners.splice(i,1); };
      },
      add(data){
        const arr = lsLoad();
        const id = "r" + Date.now().toString(36) + Math.random().toString(36).slice(2,8);
        arr.unshift(Object.assign({id}, data));
        lsSave(arr);
        return Promise.resolve({id});
      }
    };
    return self;
  },
  doc(path){
    const id = String(path).split("/").pop();
    return {
      id,
      set(){ return Promise.resolve(); },
      collection(){ return localDb.collection(); },
      update(data){
        const arr = lsLoad();
        const i = arr.findIndex(r => r.id === id);
        if(i >= 0) arr[i] = Object.assign({}, arr[i], data);
        lsSave(arr);
        return Promise.resolve();
      },
      delete(){
        lsSave(lsLoad().filter(r => r.id !== id));
        return Promise.resolve();
      }
    };
  }
};

const localAssets = {
  upload(blob){
    return new Promise((resolve, reject) => {
      const fr = new FileReader();
      fr.onload = () => resolve({id: fr.result, url: fr.result, sizeBytes: blob.size, contentType: blob.type});
      fr.onerror = () => reject(new Error("lezen mislukt"));
      fr.readAsDataURL(blob);
    });
  }
};

function localSave({filename, data}){
  return new Promise((resolve, reject) => {
    try{
      const lower = String(filename).toLowerCase();
      let blob;
      if(data instanceof ArrayBuffer) blob = new Blob([data], {type: lower.endsWith(".pdf") ? "application/pdf" : "application/octet-stream"});
      else if(typeof data === "string") blob = new Blob([data], {type: lower.endsWith(".csv") ? "text/csv;charset=utf-8" : "text/plain;charset=utf-8"});
      else blob = data instanceof Blob ? data : new Blob([data]);
      const url = URL.createObjectURL(blob);
      const a = document.createElement("a");
      a.href = url; a.download = filename; a.style.display = "none";
      document.body.appendChild(a); a.click();
      setTimeout(() => { document.body.removeChild(a); URL.revokeObjectURL(url); }, 1500);
      resolve({status:"saved"});
    }catch(e){ reject({code:"bad_request", message: e.message}); }
  });
}
const localDownloads = { save: localSave };

