  const q = v => '"' + String(v==null?"":v).replace(/"/g,'""') + '"';
  const csv = "\uFEFF" + [head.map(q).join(";")].concat(
    records.map(r => cols.map(c => q(r[c])).join(";"))
  ).join("\r\n");
  if(!downloads){ flash("Downloaden is hier niet beschikbaar.", "err"); return; }
  try{
    await downloads.save({filename:`pe-lasborging-${new Date().toISOString().slice(0,10)}.csv`, data:csv});
  }catch(e){
    if(e && e.code === "declined") return;
    flash("Export mislukt" + (e && e.code ? ` (${e.code})` : "") + ".", "err");
  }
}

/* ============================================================
   jsPDF laden — met terugval op een tweede bron
   ============================================================ */
const JSPDF_SOURCES = [
  "https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.2/jspdf.umd.min.js",
  "https://cdn.jsdelivr.net/npm/jspdf@2.5.2/dist/jspdf.umd.min.js"
];
let jsPdfLoadPromise = null;
function ensureJsPdf(){
  if(window.jspdf && window.jspdf.jsPDF) return Promise.resolve(true);
  if(jsPdfLoadPromise) return jsPdfLoadPromise;
  jsPdfLoadPromise = (async () => {
    for(const src of JSPDF_SOURCES){
      if(window.jspdf && window.jspdf.jsPDF) return true;
      const ok = await new Promise(resolve => {
        const s = document.createElement("script");
        s.src = src;
        s.onload = () => resolve(!!(window.jspdf && window.jspdf.jsPDF));
        s.onerror = () => resolve(false);
        setTimeout(() => resolve(!!(window.jspdf && window.jspdf.jsPDF)), 8000);
        document.head.appendChild(s);
      });
      if(ok) return true;
    }
    return !!(window.jspdf && window.jspdf.jsPDF);
  })();
  jsPdfLoadPromise.then(ok => { if(!ok) jsPdfLoadPromise = null; });
  return jsPdfLoadPromise;
}
